#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2154
# Build a Caeoma disk image (caeoma/ submodule) carrying archinstoo. Caeoma
# stays untouched: one generated config is layered over it with --include:
#   - archinstoo's runtime deps, from installer/PKGBUILD
#   - this checkout under /usr/share/archinstoo (Caeoma mounts only /usr)
#   - console=ttyS0 so ./RUN --script dev.vm can drive it over serial
# Output: caeoma/mkosi.output/caeoma_<version>.raw, see .github/CAEOMA.md.
# Extra args go to `mkosi` (default: build).
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF="$REPO/isos/caeoma.conf"

. "$REPO/installer/PKGBUILD"
{
	echo '# generated by isos/CAEOMA'
	echo '[Content]'
	echo 'Packages='
	printf '\t%s\n' "${depends[@]}"
	echo "ExtraTrees=$REPO/installer:/usr/share/archinstoo"
	echo 'KernelCommandLine=console=ttyS0,115200'
} >"$CONF"

# -B: Caeoma versions every build (mkosi.bump), -f: replace the last one
exec mkosi -C "$REPO/caeoma" --include="$CONF" -B -f "${@:-build}"
