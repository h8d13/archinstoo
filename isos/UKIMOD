#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2154
# Build a minimal live UKI (kernel + initrd + rootfs in one .efi) carrying
# archinstoo, via mkosi. Faster and smaller than ISOMOD, no archiso.
# Requires 'mkosi' and 'systemd-ukify'. Output: isos/a/archinstoo.efi
# Boot it: A2_UKI=isos/a/archinstoo.efi ./TVM
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MKOSI_DIR="$SCRIPT_DIR/mkosi"

# runtime deps single-sourced from the release PKGBUILD
. "$SCRIPT_DIR/../installer/PKGBUILD"
mkdir -p "$MKOSI_DIR/mkosi.conf.d"
{
	echo '# generated by isos/UKIMOD from installer/PKGBUILD'
	echo '[Content]'
	echo 'Packages='
	printf '\t%s\n' "${depends[@]}"
} >"$MKOSI_DIR/mkosi.conf.d/10-depends.conf"

# --force: overwrite isos/a/archinstoo.efi, incremental cache keeps it quick
exec mkosi -C "$MKOSI_DIR" --force "${@:-build}"
