#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2154,SC2086

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

go_to() {
	cd "$SCRIPT_DIR/$1" || exit 1
}

# keeps in sync with actual installer
log_path() {
	go_to "installer"
	python3 -c 'from archinstoo.lib.output import logger; print(logger.path)'
}

case "$1" in
-t | --tree)
	go_to "installer"
	{
		echo '# Project Tree'
		echo '```'
		tree -F -I '*.po|*.pyc|*.mo|*.png|*.svg|*.egg-info|locales|docs|logs|__pycache__|__init__.py|tests' | sed -E 's/\.pyi?(\*?)$/\1/'
		echo '```'
	} >docs/README.md
	cd "$SCRIPT_DIR" || exit 1
	{
		printf '[Desktop Entry]\nIcon=folder-build\n'
		tree -d -I '__pycache__' | sed 's/^/# /'
	} >.directory
	;;
-b | --bootstrap)
	go_to "distros"
	./BOOT
	;;
-ul | --up-logs)
	log=$(log_path)
	curl --data-binary @"$log" https://paste.rs
	;;
-gl | --grep-logs)
	log=$(log_path)
	grep -i "$2" "$log"
	;;
-gc | --grep-code)
	go_to "installer"
	git grep -ni "$2"
	;;
-tc | --test-config)
	./RUN --advanced --config examples/config_sample_full.json
	;;
-vc | --vm-config)
	./RUN --advanced --config examples/vm_configuration.json
	;;
-h2t | --host-to-target)
	go_to "installer"
	# this checks dependencies for dev workflow from top level PKGBUILD
	. ./PKGBUILD
	if [ "$2" = "-o" ] || [ "$2" = "--opt" ]; then
		pacman -Sy --needed "${depends[@]}" "${optdepends[@]}"
	else
		pacman -Sy --needed "${depends[@]}"
	fi
	;;
*)
	# otherwise, through to archinstoo
	./RUN "$@" --advanced --debug
	;;
esac
