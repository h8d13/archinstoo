{
	// Master package schema for archinstoo
	// This is the single source of truth for all package mappings
	// Used by count.py and should stay in sync with default_profiles/ and lib/

	// mirrors installer.py __base_packages__; firmware is separate below
	"base": ["base", "mkinitcpio"],

	// firmware_type picks the set. `vendor` takes its packages from the saved
	// config (FirmwareVendor values), `full` adds the optdeps detect_optdeps()
	// matches against the host PCI/USB IDs, neither of which is static
	"firmware": {
		"full": ["linux-firmware"],
		"minimal": [],
		"vendor": []
	},

	// live ISO with accessibility active installs these onto the target
	"accessibility": ["brltty", "espeakup", "alsa-utils"],

	// microcode is picked from the detected CPU, VMs get none
	"microcode": {
		"amd": ["amd-ucode"],
		"intel": ["intel-ucode"]
	},

	"ter_fonts": ["terminus-font"], // to match iso when `ter` fonts are chosen only

	"bootloaders": {
		// note efibootmgr probably isn't needed for some of these
        // like refind should be able to self-handle entries
		"systemd-boot": ["efibootmgr"],
		"grub": ["grub", "efibootmgr"],
		"limine": ["limine", "efibootmgr"],
		"efistub": ["efibootmgr"],
		"refind": ["refind"]
	},

	"filesystem_tools": {
		// note most are handled by base (e2fsprogs, dosfstools)
		// if not they are appended to base install
		"bcachefs": ["bcachefs-tools"],
		"btrfs": ["btrfs-progs"],
		"xfs": ["xfsprogs"],
		"f2fs": ["f2fs-tools"]
	},

	// bcachefs is out of tree: the module is built per kernel, so every
	// selected kernel also pulls its -headers
	"bcachefs_extra": ["bcachefs-dkms"],

	// any lvm layout
	"lvm": ["lvm2"],

	// sd-encrypt only bundles the fido2 dlopen libs if this is present at
	// initramfs build time. disk_encryption is never saved to a config
	// (the password would go with it), so count/size cannot reach this
	"fido2": ["libfido2"],

	// grub + btrfs snapshots adds these
	"grub_extra": ["grub-btrfs", "inotify-tools"],

	"snapshots": {
		"snapper": ["snapper"],
		// timeshift schedules its snapshots through cron
		"timeshift": ["timeshift", "cronie"]
	},

	// hibernation swapfile needs no entry: mkswap --file is util-linux (base
	// dep), btrfs filesystem mkswapfile is btrfs-progs via filesystem_tools
	"swap": {
		"zram": ["zram-generator"]
	},

	// always installed with any profile
	// servers only get smartmontools
	"profile_base": ["smartmontools", "xdg-utils"],

	// drivers are added before desktops
	// because they might depend on virtual vulkan-something
	// libva-mesa-driver now provided by mesa since 24.2.7
	"gfx_drivers": {
		"all-open-source": ["mesa", "xf86-video-amdgpu", "xf86-video-ati", "xf86-video-nouveau", "libva-intel-driver", "intel-media-driver", "vpl-gpu-rt", "libvpl", "vulkan-radeon", "vulkan-intel", "vulkan-nouveau"],
		"amd-open-source": ["mesa", "xf86-video-amdgpu", "xf86-video-ati", "vulkan-radeon"],
		"intel-open-source": ["mesa", "libva-intel-driver", "intel-media-driver", "vpl-gpu-rt", "libvpl", "vulkan-intel"],
		"nvidia-open-kernel": ["nvidia-open", "libva-nvidia-driver"],
		"nvidia-open-nouveau": ["mesa", "xf86-video-nouveau", "vulkan-nouveau"],
		"mesa-open-source": ["mesa"],
		"vm-software": ["mesa", "vulkan-swrast"],
		"vm-virtio": ["mesa", "vulkan-virtio"]
	},

	// -- Desktop Environments --
	"profiles": {
		"kde-plasma": ["plasma-desktop", "plasma-pa", "kscreen", "konsole", "kate", "dolphin", "ark", "bluedevil"],
		"gnome": ["gnome-shell", "gnome-session", "gnome-terminal", "gnome-control-center", "gnome-settings-daemon", "nautilus", "xdg-desktop-portal-gnome", "gnome-tweaks"],
		"xfce4": ["xfce4", "xfce4-goodies", "pavucontrol", "gvfs", "xarchiver"],
		"cinnamon": ["cinnamon", "system-config-printer", "gnome-keyring", "gnome-terminal", "engrampa", "gnome-screenshot", "gvfs-smb", "xed", "xdg-user-dirs-gtk"],
		"mate": ["mate", "mate-extra"],
		"budgie": ["materia-gtk-theme", "budgie", "dolphin", "konsole", "papirus-icon-theme"],
		"lxqt": ["lxqt", "breeze-icons", "oxygen-icons", "xdg-utils", "gnu-free-fonts", "l3afpad", "slock"],
		"deepin": ["deepin", "deepin-terminal", "deepin-editor"],
		"cosmic": ["cosmic", "xdg-user-dirs"],

		// -- Wayland WMs --
		"hyprland": ["hyprland", "dunst", "alacritty", "uwsm", "hyprlauncher", "xdg-desktop-portal-hyprland", "qt5-wayland", "qt6-wayland", "hyprpolkitagent", "grim", "slurp", "wl-clipboard"],
		"sway": ["sway", "swaybg", "swaylock", "swayidle", "wmenu", "brightnessctl", "grim", "slurp", "pavucontrol", "alacritty", "xorg-xwayland"],
		"river": ["alacritty", "xdg-desktop-portal-wlr", "river"],
		"niri": ["niri", "alacritty", "fuzzel", "mako", "xwayland-satellite", "waybar", "swaybg", "swayidle", "swaylock", "xdg-desktop-portal-gnome", "xdg-desktop-portal-gtk"],
		"dms": ["niri", "dms-shell-niri", "xdg-desktop-portal-gnome", "xorg-xwayland", "matugen", "cava", "kimageformats", "inter-font", "ttf-fira-code", "alacritty"],
		"noctalia": ["niri", "xdg-desktop-portal-gnome", "xorg-xwayland", "noctalia", "inter-font", "ttf-jetbrains-mono-nerd", "alacritty"],
		"labwc": ["alacritty", "labwc"],

		// -- Xorg WMs --
		"i3-wm": ["i3-wm", "i3lock", "i3status", "i3blocks", "xss-lock", "alacritty", "lightdm-gtk-greeter", "lightdm", "dmenu"],
		"bspwm": ["bspwm", "sxhkd", "dmenu", "xdo", "rxvt-unicode"],
		"awesome": ["xorg-server", "awesome", "alacritty", "xorg-xinit", "xorg-xrandr", "feh", "slock", "terminus-font", "gnu-free-fonts", "ttf-liberation", "xsel"],
		"enlightenment": ["enlightenment", "terminology"],
		"qtile": ["qtile", "alacritty"],
		"xmonad": ["xmonad", "xmonad-contrib", "xmonad-extras", "xterm", "dmenu"],

		// -- Servers --
		"nginx": ["nginx"],
		"docker": ["docker"],
		"httpd": ["apache"],
		"sshd": ["openssh"],
		"postgresql": ["postgresql"],
		"mariadb": ["mariadb"],
		"lighttpd": ["lighttpd"],
		"tomcat": ["tomcat10"],
		"cockpit": ["cockpit", "cockpit-storaged", "cockpit-packagekit"],
		"java": ["jre-openjdk-headless"],
		"tailscale": ["tailscale"]
	},

	// per-compositor package sets for the dms profile; its "profiles" entry
	// above bakes in the niri default, dms_compositor custom_settings swaps it
	"dms_compositors": {
		"niri": ["niri", "dms-shell-niri", "xdg-desktop-portal-gnome", "xorg-xwayland"],
		"hyprland": ["hyprland", "dms-shell-hyprland", "xdg-desktop-portal-hyprland", "uwsm"]
	},
	// we could add sway, labwc or any they support here

	// same mechanism for the noctalia profile (niri default baked above)
	"noctalia_compositors": {
		"niri": ["niri", "xdg-desktop-portal-gnome", "xorg-xwayland"],
		"hyprland": ["hyprland", "xdg-desktop-portal-hyprland", "uwsm"],
		"sway": ["sway", "xdg-desktop-portal-wlr", "xorg-xwayland"],
		"labwc": ["labwc", "xdg-desktop-portal-wlr", "xorg-xwayland"]
	},

	// profiles that need xorg-server/xorg-xinit when a gfx driver is selected
	// (the X11 half of DisplayServer, i.e. every XorgProfile subclass)
	"xorg_profiles": ["xfce4", "cinnamon", "mate", "lxqt", "deepin", "i3-wm", "bspwm", "awesome", "enlightenment", "qtile", "xmonad"],

	// each desktop specifies a default greeter
	// None is always available (stored as null in config) and any greeter can be picked
	"greeters": {
		"lightdm-slick-greeter": ["lightdm", "lightdm-slick-greeter"],
		"lightdm-gtk-greeter": ["lightdm", "lightdm-gtk-greeter"],
		"plasma-login-manager": ["plasma-login-manager"],
		"sddm": ["sddm"],
		"gdm": ["gdm"],
		"ly": ["ly"],
		"greetd": ["greetd"],
		"dms-greeter": ["greetd"],
		"regreet": ["greetd", "greetd-regreet", "cage"],
		"cosmic-greeter": ["cosmic-greeter"]
	},

	// this a 'advanced' option but seems to work fine
	// run0 part of polkit/systemd
	"privilege_escalation": {
		"run0": ["polkit"],
		"sudo": ["sudo"],
		"doas": ["opendoas"]
	},

	"shells": {
		// bash is default rbash for guest, no extra package needed
		"zsh": ["zsh"],
		"fish": ["fish"]
	},

	"bluetooth": ["bluez", "bluez-utils"],

	"audio": {
		"pipewire": ["pipewire", "pipewire-alsa", "pipewire-jack", "pipewire-pulse", "gst-plugin-pipewire", "libpulse", "wireplumber", "rtkit"],
		"pulseaudio": ["pulseaudio"]
	},

	// added with either audio server when the matching driver is loaded
	"audio_firmware": {
		"sof": ["sof-firmware"],
		"alsa": ["alsa-firmware"]
	},

	// ghostscript is the PostScript interpreter cups needs for most drivers
	"printing": ["cups", "system-config-printer", "cups-pk-helper", "ghostscript"],

	"firewalls": {
		"ufw": ["ufw"],
		"firewalld": ["firewalld"]
	},

	"management": {
		"git": ["git"],
		"openssh": ["openssh"],
		"wget": ["wget"],
		"base-devel": ["base-devel"],
		"man-db": ["man-db"],
		"pacman-contrib": ["pacman-contrib"],
		"reflector": ["reflector"],
		"ntsync-autoload": ["ntsync-autoload"]
	},

	"monitors": {
		"htop": ["htop"],
		"btop": ["btop"],
		"bottom": ["bottom"]
	},

	"editors": {
		"nano": ["nano"],
		"micro": ["micro"],
		"vi": ["ex-vi-compat"],
		"vim": ["vim"],
		"neovim": ["neovim"],
		"emacs": ["emacs"]
	},

	// one choice, shared by every profile that needs a terminal. package and
	// binary share a name, and TERMINAL lands in /etc/environment
	"terminals": {
		"alacritty": ["alacritty"],
		"foot": ["foot"],
		"kitty": ["kitty"],
		"ghostty": ["ghostty"],
		"konsole": ["konsole"],
		"wezterm": ["wezterm"],
		"xterm": ["xterm"]
	},

	// only showed on laptops
	"power_management": {
		"power-profiles-daemon": ["power-profiles-daemon"],
		"tuned": ["tuned", "tuned-ppd"]
	},

	"security": {
		"apparmor": ["apparmor"],
		"firejail": ["firejail"],
		"bubblewrap": ["bubblewrap"],
		"fail2ban": ["fail2ban"],
		"pam-u2f": ["pam-u2f"],
		"sbctl": ["sbctl"],
		"audit": ["audit"]
	},

	"languages": {
		"rustup": ["rustup"],
		"go": ["go"],
		"jdk-openjdk": ["jdk-openjdk"],
		"nodejs": ["nodejs"],
		"clang": ["clang"],
		"zig": ["zig"],
		"lua": ["lua"]
	},

	"devtools": {
		"cmake": ["cmake"],
		"make": ["make"],
		"ninja": ["ninja"],
		"meson": ["meson"],
		"gdb": ["gdb"],
		"llvm": ["llvm"],
		"lld": ["lld"],
		"lldb": ["lldb"],
		"perf": ["perf"],
		"strace": ["strace"],
		"ltrace": ["ltrace"],
		"valgrind": ["valgrind"]
	},

	"network": {
		"nm": ["networkmanager", "wpa_supplicant"],
		"nm-iwd": ["networkmanager", "iwd"],
		"iwd": ["iwd"],
		// nm adds network-manager-applet for desktop profiles
		"nm-desktop-extra": ["network-manager-applet"]
	}
}
