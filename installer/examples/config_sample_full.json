    "swap": {
        "zram": true,
        "algorithm": "lz4",
        "recomp_algorithm": "zstd",
        "hibernation": true
    },
    "kernels": [
        "kernel"
    ],
    "kernel_headers": false,
    "firmware": {
        "firmware_type": "vendor",
        "vendors": [
            "iwlwifi-mvm-firmware"
        ]
    },
    "profile_config": {
        "profiles": [
            {
                "main": "desktop",
                "details": [
                    "kde-plasma"
                ],
                "custom_settings": {
                    "kde-plasma": {}
                }
            },
            {
                "main": "server",
                "details": [
                    "docker",
                    "sshd"
                ],
                "custom_settings": {}
            }
        ],
        "greeter": "gdm"
    },
    "gfx_driver": "intel-open-source",
    "gfx_packages": [],
    "hostname": "archinstoo",
    "auth_config": {
        "lock_root_account": true,
        "privilege_escalation": "doas",
        "users": [
            {
                "username": "myuser",
                "elev": true,
                "shell": "bash"
            }
        ]
    },
    "app_config": {
        "bluetooth_config": {
            "enabled": true
        },
        "thunderbolt_config": {
            "enabled": true
        },
        "audio_config": {
            "audio": "pipewire"
        },
        "media_codecs_config": {
            "enabled": true
        },
        "flatpak_config": {
            "enabled": true
        },
        "power_management_config": {
            "power_management": "power-profiles-daemon"
        },
        "print_service_config": {
            "enabled": true
        },
        "firewall_config": {
            "firewall": "ufw"
        },
        "management_config": {
            "tools": [
                "git",
                "man-db",
                "dnf5-plugins"
            ]
        },
        "monitor_config": {
            "monitor": "btop"
        },
        "editor_config": {
            "editor": "micro"
        },
        "terminal_config": {
            "terminal": "alacritty"
        },
        "security_config": {
            "tools": [
                "fail2ban"
            ]
        }
    },
    "network_config": {
        "type": "nm-iwd",
        "dns": {
            "provider": "quad9",
            "over_tls": true
        }
    },
    "timezone": "Europe/Berlin",
    "ntp": true,
    "packages": [
        "syncthing",
        "chromium"
    ],
    "sysctl": {
        "optimized": false,
        "entries": []
    },
    "services": [
        "sshd",
        {
            "unit": "syncthing.service",
            "user": "myuser",
            "linger": true
        }
    ],
    "custom_commands": [
        "#arch-chroot via bash tmp files # lines are ignored",
        "#ex: su - myuser -c 'bash ~/.stash/repo/install.sh'"
    ]
}
