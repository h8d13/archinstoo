#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2154
# the caller's directory stays the cwd, so relative paths (--config) resolve
# where they were typed; -P keeps that directory off sys.path
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHONPATH="$SCRIPT_DIR/installer${PYTHONPATH:+:$PYTHONPATH}" exec python3 -B -P -m archinstoo "$@"
