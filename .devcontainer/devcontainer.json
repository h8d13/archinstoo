{
	"name": "archinstoo",
	"build": { "dockerfile": "Dockerfile", "context": "../installer" },
	"remoteUser": "root",
	// installer needs root and loop devices for ./RUN, drop for editing only
	"privileged": true,
	"postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && pre-commit install --install-hooks",
	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python", "charliermarsh.ruff"]
		}
	}
}
