{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "configMigration": true,
  "pre-commit": {
    "enabled": true
  },
  "customDatasources": {
    "archlinux": {
      "defaultRegistryUrlTemplate": "https://archlinux.org/packages/search/json/?name={{packageName}}",
      "transformTemplates": [
        "{\"releases\": [results[repo in [\"core\", \"extra\"]].{\"version\": pkgver}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Floors tracked via Arch Linux repos, annotated inline with `# renovate: arch=<pkg>`",
      "managerFilePatterns": [
        "**/pyproject.toml"
      ],
      "matchStrings": [
        "\"[^\"]*?>=(?<currentValue>[^\"]+)\",?\\s*#\\s*renovate:\\s*arch=(?<depName>\\S+)"
      ],
      "depNameTemplate": "arch/{{{depName}}}",
      "datasourceTemplate": "custom.archlinux",
      "versioningTemplate": "loose",
      "packageNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "Pinned python deps of repo: local pre-commit hooks (pylint, import-linter), the pre-commit manager skips local hooks",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "-\\s+(?<depName>[A-Za-z0-9][A-Za-z0-9._-]*)==(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Python floor moves with Arch minor releases, not point releases",
      "matchDepNames": [
        "arch/python"
      ],
      "extractVersion": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "description": "Versions tracked via Arch repos (# renovate: arch=), never PyPI",
      "matchDatasources": [
        "pypi",
        "python-version"
      ],
      "matchPackageNames": [
        "pyparted",
        "python",
        "mypy",
        "pre-commit",
        "ruff",
        "pylint",
        "pytest"
      ],
      "enabled": false
    }
  ]
}
