{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "configMigration": true,
  "pre-commit": {
    "enabled": true
  },
  "customDatasources": {
    "archlinux": {
      "defaultRegistryUrlTemplate": "https://archlinux.org/packages/search/json/?name={{packageName}}",
      "transformTemplates": [
        "{\"releases\": [results[repo in [\"core\", \"extra\"]].{\"version\": pkgver}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Floors tracked via Arch Linux repos, annotated inline with `# renovate: arch=<pkg>`",
      "managerFilePatterns": [
        "**/pyproject.toml"
      ],
      "matchStrings": [
        "\"[^\"]*?>=(?<currentValue>[^\"]+)\",?\\s*#\\s*renovate:\\s*arch=(?<depName>\\S+)"
      ],
      "depNameTemplate": "arch/{{{depName}}}",
      "datasourceTemplate": "custom.archlinux",
      "versioningTemplate": "loose",
      "packageNameTemplate": "{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "mypy",
        "ruff",
        "pre-commit",
        "pre-commit/pre-commit-hooks",
        "pre-commit/mirrors-mypy",
        "astral-sh/ruff-pre-commit"
      ]
    },
    {
      "description": "Python floor moves with Arch minor releases, not point releases",
      "matchDepNames": [
        "arch/python"
      ],
      "extractVersion": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "description": "Disable upstream updates for versions tracked via Arch repos",
      "matchDatasources": [
        "pypi",
        "python-version"
      ],
      "matchPackageNames": [
        "pyparted",
        "python"
      ],
      "enabled": false
    }
  ]
}
