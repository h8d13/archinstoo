#!/usr/bin/env bash
# shellcheck disable=SC1091,SC2154
# sudo pacman -S --needed qemu-base qemu-ui-gtk qemu-audio-pipewire edk2-ovmf
# (swap qemu-ui-gtk for qemu-ui-sdl/qemu-ui-curses if you prefer; set DISPLAY_BACKEND to match)
# (audio backend is a separate pkg: qemu-audio-pipewire (default), qemu-audio-pa, qemu-audio-alsa; set AUDIO_BACKEND to match)
#
# Dev test VM for archinstoo. Boots an ISO under QEMU.
# ISO building is intentionally NOT done here, use isos/ISOMOD for that/default Arch ISO.
# Credits to @Softer, modified for archinstoo.
#
# Host artifacts (created in repo root, git-ignored):
#   .dev-disk.qcow2     VM disk image (qemu-img)
#   .dev-ovmf-vars.fd   persistent UEFI NVRAM (copied from OVMF_VARS)
#   SERIAL=on only:
#   .dev-boot/          kernel + initramfs pulled out of the ISO
#   .dev-serial.sock    guest ttyS0, .dev-serial.log its full transcript
#   .dev-capture.log    guest ttyS1, byte-exact (./TSER capture)
#   .dev-monitor.sock   QEMU HMP monitor, .dev-vm.pid the daemon pid
#
# Usage:
#   ./TVM            - fresh disk, boot ISO
#   ./TVM keep   | k - reuse disk, boot ISO
#   ./TVM boot   | b - boot from installed disk (no ISO)
#   ./TVM clean  | c - remove disk and NVRAM (ISOs untouched)
#   ./TVM help   | h - show this help
# Env overrides:
#   SERIAL             'on' boots headless with the console on ttyS0 and
#                      detaches (no window, no stdio monitor). Composes with
#                      every mode above. Drive it with ./TSER (login/run/wait).
#                      ISO modes direct-boot the ISO's own kernel via -kernel so
#                      console=ttyS0 can be forced; OVMF still boots it EFI-stub,
#                      so the guest keeps a real UEFI environment. Needs bsdtar.
#                      'boot' mode has no such hook: the installed system only
#                      talks to ttyS0 if its own cmdline says console=ttyS0.
#   DEV_ISO            explicit ISO path (skips discovery)
#   RAM, CPUS          VM resources (default 4G, 4)
#   DISK_SIZE          new disk size (default 30G)
#   DISPLAY_BACKEND    qemu -display value (default 'gtk,zoom-to-fit=off')
#   VGA                qemu -vga value (default 'std'; 'virtio' needs qemu-hw-display-virtio-vga)
#   GL                 'on' swaps video for virtio-vga-gl + display gl=on (virgl 3D accel).
#                      Overrides VGA. niri/DMS have no software fallback, black-screen
#                      without this. Needs the full module chain (vga-gl alone won't load):
#                      qemu-hw-display-virtio-{gpu,gpu-gl,vga,vga-gl} + qemu-ui-opengl
#   AUDIO_BACKEND      qemu -audiodev value (default 'pipewire'; 'pa'/'alsa' need the matching qemu-audio-* pkg)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"
DISK="$PROJECT_DIR/.dev-disk.qcow2"
OVMF_VARS="$PROJECT_DIR/.dev-ovmf-vars.fd"
ISOMOD_OUT="$PROJECT_DIR/isos/a"
DEV_ISO_DIR="$PROJECT_DIR/.dev-iso"
BOOT_DIR="$PROJECT_DIR/.dev-boot"
SERIAL_SOCK="$PROJECT_DIR/.dev-serial.sock"
SERIAL_LOG="$PROJECT_DIR/.dev-serial.log"
CAPTURE_LOG="$PROJECT_DIR/.dev-capture.log"
MON_SOCK="$PROJECT_DIR/.dev-monitor.sock"
PIDFILE="$PROJECT_DIR/.dev-vm.pid"
SERIAL="${SERIAL:-off}"
DISK_SIZE="${DISK_SIZE:-64G}"
RAM="${RAM:-4G}"
CPUS="${CPUS:-4}"
DISPLAY_BACKEND="${DISPLAY_BACKEND:-gtk,zoom-to-fit=off}"
VGA="${VGA:-std}"
GL="${GL:-off}"
AUDIO_BACKEND="${AUDIO_BACKEND:-pipewire}"
ARG="${1:-default}"

OVMF_CODE=""
OVMF_VARS_ORIG=""

err() {
	echo "ERROR: $*" >&2
	exit 1
}

probe_ovmf() {
	local pairs=(
		"/usr/share/edk2/x64/OVMF_CODE.4m.fd:/usr/share/edk2/x64/OVMF_VARS.4m.fd"
		"/usr/share/edk2-ovmf/x64/OVMF_CODE.fd:/usr/share/edk2-ovmf/x64/OVMF_VARS.fd"
		"/usr/share/edk2/ovmf/OVMF_CODE.fd:/usr/share/edk2/ovmf/OVMF_VARS.fd"
		"/usr/share/OVMF/OVMF_CODE_4M.fd:/usr/share/OVMF/OVMF_VARS_4M.fd"
		"/usr/share/OVMF/OVMF_CODE.fd:/usr/share/OVMF/OVMF_VARS.fd"
	)
	local pair code vars
	for pair in "${pairs[@]}"; do
		code="${pair%%:*}"
		vars="${pair##*:}"
		if [ -f "$code" ] && [ -f "$vars" ]; then
			OVMF_CODE="$code"
			OVMF_VARS_ORIG="$vars"
			return 0
		fi
	done
	err "OVMF firmware not found. Install 'edk2-ovmf' or similar on your distro."
}

check_host_deps() {
	local missing=() cmd
	for cmd in qemu-system-x86_64 qemu-img; do
		command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
	done
	if [ ${#missing[@]} -gt 0 ]; then
		err "missing host commands: ${missing[*]} (install qemu-base)"
	fi
	if [ "$SERIAL" = "on" ]; then
		command -v bsdtar >/dev/null 2>&1 ||
			err "SERIAL=on needs bsdtar to read the ISO (install libarchive)"
	fi
}

ensure_no_running_vm() {
	local pid
	[ -f "$PIDFILE" ] || return 0
	pid="$(cat "$PIDFILE")"
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		err "VM already running (pid $pid), stop it with ./TSER quit"
	fi
	rm -f "$PIDFILE"
}

# The ISO's bootloader entries carry no serial console, and editing them at
# the systemd-boot menu over serial is not scriptable. Pull the kernel and
# initramfs out of the ISO instead and hand them to QEMU directly, reusing
# the entry's own cmdline (archisosearchuuid changes every release) with
# console=ttyS0 appended. The ISO stays attached as a cdrom: the archiso hook
# still finds the squashfs on it.
extract_iso_kernel() {
	local iso="$1" stamp="$BOOT_DIR/.stamp" want
	want="$iso:$(stat -c %Y "$iso")"
	mkdir -p "$BOOT_DIR"
	if [ ! -f "$stamp" ] || [ "$(cat "$stamp")" != "$want" ]; then
		echo "extracting kernel/initramfs from $(basename "$iso")"
		bsdtar -xOf "$iso" arch/boot/x86_64/vmlinuz-linux \
			>"$BOOT_DIR/vmlinuz-linux"
		bsdtar -xOf "$iso" arch/boot/x86_64/initramfs-linux.img \
			>"$BOOT_DIR/initramfs-linux.img"
		bsdtar -xOf "$iso" loader/entries/01-archiso-linux.conf |
			sed -n 's/^options[[:space:]]\+//p' >"$BOOT_DIR/cmdline"
		printf '%s\n' "$want" >"$stamp"
	fi
	[ -s "$BOOT_DIR/vmlinuz-linux" ] || err "no kernel in $iso (archiso layout?)"
	[ -s "$BOOT_DIR/cmdline" ] || err "no boot cmdline in $iso (archiso layout?)"
}

find_iso() {
	if [ -n "${DEV_ISO:-}" ]; then
		[ -f "$DEV_ISO" ] || err "DEV_ISO=$DEV_ISO not found"
		printf '%s\n' "$DEV_ISO"
		return
	fi
	{ ls -t "$ISOMOD_OUT"/*.iso "$DEV_ISO_DIR"/*.iso 2>/dev/null || true; } | head -n1
}

require_iso() {
	local iso
	iso="$(find_iso)"
	if [ -z "$iso" ]; then
		err "No ISO found. Build one with isos/ISOMOD, drop one in $DEV_ISO_DIR/ or $ISOMOD_OUT, or set DEV_ISO=/path/to.iso"
	fi
	printf '%s\n' "$iso"
}

case "$ARG" in
-h | --help | help)
	sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
	exit 0
	;;
clean | c)
	ensure_no_running_vm
	rm -fv "$DISK" "$OVMF_VARS" "$SERIAL_SOCK" "$SERIAL_LOG" "$CAPTURE_LOG" "$MON_SOCK"
	rm -rfv "$BOOT_DIR"
	exit 0
	;;
boot | b)
	check_host_deps
	ensure_no_running_vm
	probe_ovmf
	[ -f "$DISK" ] || err "Disk missing, run without args first"
	BOOT_ORDER="c"
	ATTACH_ISO=false
	;;
keep | k)
	check_host_deps
	ensure_no_running_vm
	probe_ovmf
	[ -f "$DISK" ] || err "Disk missing, run without args first"
	require_iso >/dev/null
	BOOT_ORDER="d"
	ATTACH_ISO=true
	;;
default)
	check_host_deps
	ensure_no_running_vm
	probe_ovmf
	require_iso >/dev/null
	rm -f "$DISK"
	qemu-img create -f qcow2 "$DISK" "$DISK_SIZE"
	BOOT_ORDER="d"
	ATTACH_ISO=true
	;;
*)
	err "Unknown argument: $ARG (try -h)"
	;;
esac

[ -f "$OVMF_VARS" ] || cp "$OVMF_VARS_ORIG" "$OVMF_VARS"

# shellcheck disable=SC2054 # commas are qemu device/netdev value syntax, not array separators
if [ "$SERIAL" = "on" ]; then
	# Headless and detached: the console is a unix socket with a logfile, so
	# ./TSER can connect, act and exit instead of holding a session open.
	# Audio is dropped, no session to play into.
	# ttyS1 is a plain file chardev, and that is the point: the socket's
	# logfile duplicates bytes replayed after a partial write, so guest
	# output redirected to /dev/ttyS1 is the only byte-exact transcript
	# (./TSER capture). ttyS0 stays the interactive end.
	rm -f "$SERIAL_SOCK" "$MON_SOCK" "$SERIAL_LOG" "$CAPTURE_LOG"
	CONSOLE_ARGS=(
		-display none
		-chardev "socket,id=ser0,path=$SERIAL_SOCK,server=on,wait=off,logfile=$SERIAL_LOG,logappend=on"
		-serial chardev:ser0
		-chardev "file,id=cap0,path=$CAPTURE_LOG"
		-serial chardev:cap0
		-monitor "unix:$MON_SOCK,server=on,wait=off"
		-pidfile "$PIDFILE"
		-daemonize
	)
else
	# virgl needs both ends: GL-capable device AND gl=on on the display.
	# -device help skips unloaded modules; probe with device-specific help instead.
	if [ "$GL" = "on" ]; then
		if qemu-system-x86_64 -device virtio-vga-gl,help 2>&1 | grep -q "not found"; then
			err "virtio-vga-gl not loadable (install qemu-hw-display-virtio-{gpu,gpu-gl,vga,vga-gl} and qemu-ui-opengl)"
		fi
		CONSOLE_ARGS=(-device virtio-vga-gl -display "$DISPLAY_BACKEND,gl=on")
	else
		CONSOLE_ARGS=(-vga "$VGA" -display "$DISPLAY_BACKEND")
	fi
	CONSOLE_ARGS+=(
		-audiodev "$AUDIO_BACKEND,id=snd0"
		-device ich9-intel-hda
		-device hda-duplex,audiodev=snd0
		-monitor stdio
	)
fi

# shellcheck disable=SC2054 # commas are qemu device/netdev value syntax, not array separators
QEMU_ARGS=(
	-machine q35
	-cpu host
	-enable-kvm
	-m "$RAM"
	-smp "$CPUS"
	-drive "file=$DISK,format=qcow2,if=virtio"
	-device virtio-net-pci,netdev=net0
	-netdev user,id=net0
	"${CONSOLE_ARGS[@]}"
	-drive "if=pflash,format=raw,readonly=on,file=$OVMF_CODE"
	-drive "if=pflash,format=raw,file=$OVMF_VARS"
	-boot "order=$BOOT_ORDER"
)

if [ "$ATTACH_ISO" = "true" ]; then
	ISO="$(require_iso)"
	QEMU_ARGS+=(-cdrom "$ISO")
	if [ "$SERIAL" = "on" ]; then
		extract_iso_kernel "$ISO"
		QEMU_ARGS+=(
			-kernel "$BOOT_DIR/vmlinuz-linux"
			-initrd "$BOOT_DIR/initramfs-linux.img"
			-append "$(cat "$BOOT_DIR/cmdline") console=ttyS0,115200"
		)
	fi
fi

if [ "$SERIAL" = "on" ]; then
	qemu-system-x86_64 "${QEMU_ARGS[@]}"
	echo "VM detached, pid $(cat "$PIDFILE")"
	echo "drive it: ./TSER login && ./TSER run 'ls /'"
	exit 0
fi

trap 'stty sane' EXIT
qemu-system-x86_64 "${QEMU_ARGS[@]}"
