#!/usr/bin/env bash
# if we are root, check ISO
if [ "$EUID" -eq 0 ]; then
	if mountpoint -q /run/archiso/cowspace; then
		# on iso probably need more space
		mount -o remount,size=1G /run/archiso/cowspace
	fi
	# check deps
	pacman -S --needed uv gcc pkgconf || exit 1
fi

# rootless runs skip install: pacman -T prints whatever is missing
if ! pacman -T uv gcc pkgconf; then
	echo "UVRUN: missing deps above, run once as root to install" >&2
	exit 1
fi

cd installer || exit 1
# reuse existing venv; uv picks (or fetches) python from requires-python
if [ ! -x .venv/bin/python ]; then
	uv venv .venv || exit 1
fi
# editable: cheap re-run, picks up pyproject dep changes
uv pip install -p .venv -e . || exit 1

exec .venv/bin/python -B -m archinstoo "$@"
