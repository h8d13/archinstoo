#!/usr/bin/env bash
# venv run on an installed Fedora: pyparted builds from PyPI, and Fedora
# splits the headers it needs (Python.h, libparted) into -devel packages
DEPS=(uv gcc pkgconf python3-devel parted-devel)

if [ "$EUID" -eq 0 ]; then
	dnf install -y "${DEPS[@]}" || exit 1
fi

# rootless runs skip install: rpm -q names whatever is missing
if ! rpm -q "${DEPS[@]}"; then
	echo "UVRUN: missing deps above, run once as root to install" >&2
	exit 1
fi

INSTALLER="$(cd "$(dirname "${BASH_SOURCE[0]}")/installer" && pwd)"
VENV="$INSTALLER/.venv"
# reuse existing venv; uv picks (or fetches) python from requires-python
if [ ! -x "$VENV/bin/python" ]; then
	uv venv "$VENV" || exit 1
fi
# editable: cheap re-run, picks up pyproject dep changes. It also makes the
# package importable from anywhere, so the caller's cwd stays (relative
# --config) and -P keeps that directory off sys.path
uv pip install -p "$VENV" -e "$INSTALLER" || exit 1

exec "$VENV/bin/python" -B -P -m archinstoo "$@"
